APP_NAME=DropVoice API
ENVIRONMENT=development
API_PREFIX=/v1
DATABASE_URL=sqlite+aiosqlite:///./dropvoice.db
DEVICE_TOKEN_SECRET=replace-me
CORS_ORIGINS=["http://127.0.0.1:3000","http://localhost:3000","http://127.0.0.1:5500","http://localhost:5500","http://127.0.0.1:8080","http://localhost:8080"]

CARTESIA_API_KEY=replace-me
CARTESIA_BASE_URL=https://api.cartesia.ai
CARTESIA_API_VERSION=2026-03-01
CARTESIA_MODEL_ID=sonic-3-2026-01-12
CARTESIA_DEFAULT_VOICE_ID=6ccbfb76-1fc6-48f7-b71d-91ac6298247b
CARTESIA_CONCURRENCY_LIMIT=3
MOCK_TTS=true
PRONUNCIATION_DICT_PATH=pronunciation.json

GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_BASE_URL=https://api.groq.com/openai/v1
TRANSCRIPT_REWRITER=groq

OPAY_MERCHANT_ID=replace-me
OPAY_PUBLIC_KEY=replace-me
OPAY_PRIVATE_KEY=replace-me
OPAY_API_BASE_URL=https://testapi.opaycheckout.com
OPAY_CALLBACK_URL=https://api.example.com/v1/topups/opay/webhook
OPAY_RETURN_URL=dropvoice://payments/return
OPAY_CANCEL_URL=dropvoice://payments/cancel
MOCK_PAYMENTS=true

DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,ar,zh,hi,es,fr,de,pt,it,ja,ko,ru,nl,tr,pl
PRICE_PER_GENERATION_KOBO=400000
CHAR_LIMIT=400
MAX_CLONE_UPLOAD_BYTES=5242880
CLONE_MIN_DURATION_SECONDS=5
CLONE_MAX_DURATION_SECONDS=20
DEFAULT_PACE=normal
AUDIO_TTL_MINUTES=60
QUEUE_POLL_INTERVAL_MS=1000
